DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_DB=speaking_demo
POSTGRES_USER=speaking_demo
POSTGRES_PASSWORD=replace-this-local-password
DB_HOST=127.0.0.1
DB_PORT=55433
HOST_DB_PORT=55433
WEB_PORT=18080
# Containerized web/worker override this to redis://redis:6379/0.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
LOCAL_AI_BASE_URL=http://host.docker.internal:11434
LOCAL_AI_MODEL=ornith-1.5:9b
LOCAL_AI_TIMEOUT_SECONDS=150

# Used only by the explicit `python manage.py seed_demo` command. Replace all three.
DEMO_STUDENT_PASSWORD=replace-with-a-unique-local-student-password
DEMO_TEACHER_PASSWORD=replace-with-a-unique-local-teacher-password
DEMO_ADMIN_PASSWORD=replace-with-a-unique-local-admin-password
